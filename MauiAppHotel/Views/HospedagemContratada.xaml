<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="CenterAndExpand">

        <Label Text="Suíte Super Luxo" 
               TextColor="#5C3B34"
               FontFamily="Kalam"
               FontSize="50"
               HorizontalTextAlignment="Center"/>

        <Frame Padding="20"
               Margin="10,0"
               BorderColor="#D9B176"
               CornerRadius="20"
               BackgroundColor="White">
            <HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Adultos: "
                           FontAttributes="Bold"
                           FontSize="18"/>
                    <Label Text="2"
                           FontSize="22"
                           TextColor="#5C3B34"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Margin="40,0,0,0">
                    <Label Text="Crianças: "
                           FontAttributes="Bold"
                           FontSize="18"/>
                    <Label Text="2"
                           FontSize="22"
                           TextColor="#5C3B34"/>
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </Frame>

        <Frame Margin="10"
               Padding="20"
               CornerRadius="20"
               BorderColor="#D9B176"
               BackgroundColor="White">
            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Check-in" FontAttributes="Bold" />
                <Label Grid.Row="0" Grid.Column="1" Text="Check-iout" FontAttributes="Bold"/>
                <Label Grid.Row="0" Grid.Column="2" Text="estadia" FontAttributes="Bold"/>

                <Label Grid.Row="1" Grid.Column="0" Text="27/05/2016"/>
                <Label Grid.Row="1" Grid.Column="1" Text="30/05*2026"/>
                <Label Grid.Row="1" Grid.Column="2" Text="3 dias"  />
            </Grid>
        </Frame>

        <Frame Margin="10,0"
                Padding="20"
                CornerRadius="20"
                BorderColor="#D9B176"
                BackgroundColor="White">
            <HorizontalStackLayout>
                <Label Text="Valor Total:"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="#5C3B34"/>
                <Label Text="R$ 750,00"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="#5C3B34"/>
            </HorizontalStackLayout>
        </Frame>

        <Button Text="Voltar"
                BackgroundColor="#9A7C70"
                TextColor="White"
                HeightRequest="55"
                WidthRequest="220"
                CornerRadius="15"
                HorizontalOptions="Center"
                Clicked="Button_Clicked"/>

    </VerticalStackLayout>
    
</ContentPage>
